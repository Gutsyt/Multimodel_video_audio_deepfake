# Copy to .env if you like; the server reads real environment variables (see docs/runbook_local.md).
# Never commit .env. None of these is a secret; the backend needs no API keys.
AVDD_DATA_DIR=app_data
AVDD_MAX_UPLOAD_MB=100
AVDD_MAX_DURATION_S=60
AVDD_MAX_IMAGE_MEGAPIXELS=40
AVDD_AUDIO_MODEL=AASIST
AVDD_VIDEO_MODEL=hf
# Comma-separated origins allowed to call the API from a browser (only needed when the frontend is hosted elsewhere)
AVDD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AVDD_FRONTEND_DIST=frontend/dist   (serve the built UI from the backend, same origin)
